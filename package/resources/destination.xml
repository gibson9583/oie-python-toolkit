<connectorMetaData path="python-runtime">
    <name>Python Writer</name>
    <author>OIE Contributors</author>
    <pluginVersion>${project.version}</pluginVersion>
    <mirthVersion>${mirth.compatible.versions}</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Executes Python using the current deployed script environment.</description>
    <protocol>Python</protocol>
    <type>DESTINATION</type>
    <transformers><string>Raw</string><string>HL7 v2.x</string><string>XML</string><string>JSON</string><string>Delimited Text</string></transformers>
    <clientClassName>com.mirth.connect.plugins.python.client.PythonDispatcherPanel</clientClassName>
    <serverClassName>com.mirth.connect.plugins.python.server.PythonDispatcher</serverClassName>
    <sharedClassName>com.mirth.connect.connectors.python.PythonDispatcherProperties</sharedClassName>
    <apiProvider type="SERVLET_INTERFACE" name="com.mirth.connect.plugins.python.PythonRuntimeServletInterface"/>
    <apiProvider type="SERVER_CLASS" name="com.mirth.connect.plugins.python.server.PythonRuntimeServlet"/>
    <library type="SHARED" path="libs/oie-python-toolkit-shared-${project.version}.jar"/>
    <library type="SERVER" path="libs/oie-python-toolkit-server-${project.version}.jar"/>
    <library type="CLIENT" path="libs/oie-python-toolkit-client-${project.version}.jar"/>
</connectorMetaData>
